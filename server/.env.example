# Copy this file to server/.env and fill in your own values. Never commit server/.env.
PORT=5000

# Use 127.0.0.1 rather than localhost (on Windows, Node can resolve localhost to ::1, which XAMPP's MySQL doesn't listen on)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=fundilink

# API keys: one per consumer, comma-separated, no spaces. Generate each one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# e.g. first = our team's testing key, second = our downstream partner's key
API_KEYS=<team-key>,<partner-key>

# Rate limit per key: RATE_LIMIT_MAX requests per RATE_LIMIT_WINDOW_MS milliseconds
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Week 10: our upstream partner (NyumbaHub). Our server calls them; the browser never sees this key.
PARTNER_URL=https://nyumbahub-api-gdit.onrender.com
PARTNER_API_KEY=<key-nyumbahub-gave-us>
PARTNER_KEY_HEADER=X-API-Key
# Show homes that became available on/after this date (YYYY-MM-DD, as NyumbaHub's README uses)
PARTNER_UPDATED_SINCE=2026-01-01
