# Copy this file to server/.env and fill in your own values. Never commit server/.env.
PORT=5000

# Use 127.0.0.1 rather than localhost (on Windows, Node can resolve localhost to ::1, which XAMPP's MySQL doesn't listen on)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=fundilink
# Cloud database (TiDB Cloud): use its host, port 4000, its user (like xxxx.root) and password, and DB_SSL=true.
# Leave DB_SSL out for XAMPP on a laptop.
# DB_SSL=true

# API keys: one per consumer, comma-separated, no spaces. Generate each one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# e.g. first = our team's testing key, second = our downstream partner's key
API_KEYS=<team-key>,<partner-key>

# Rate limit per key: RATE_LIMIT_MAX requests per RATE_LIMIT_WINDOW_MS milliseconds
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Week 10: our upstream partner (NyumbaHub). Our server calls them; the browser never sees this key.
PARTNER_URL=https://nyumbahub-api-gdit.onrender.com
PARTNER_API_KEY=<key-nyumbahub-gave-us>
PARTNER_KEY_HEADER=X-API-Key
# Show homes that became available on/after this date (YYYY-MM-DD, as NyumbaHub's README uses)
PARTNER_UPDATED_SINCE=2026-01-01

# Only when deployed behind a proxy (Render): read visitors' real IPs for the per-IP limits.
# TRUST_PROXY=true

# Website logins (session tokens) are signed with this. Set a long random string so logins survive
# a restart:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEB_SESSION_SECRET=<long-random-string>

# Week 11: give up on one NyumbaHub call after this many ms (it's retried at most twice)
PARTNER_TIMEOUT_MS=2000
# Week 13: which NyumbaHub API version we call (see server/server/partnerVersions.js)
PARTNER_VERSION=v1

# Week 12: also write the request log to this file (git-ignored). Leave unset to log to the terminal only.
# LOG_FILE=requests.log

# Week 13: date our v1 stops working (sent in the Sunset header)
API_V1_SUNSET=2026-11-20
